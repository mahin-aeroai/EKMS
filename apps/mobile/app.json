{
  "expo": {
    "name": "MMDI ONE",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ekms.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "MMDI ONE uses your microphone so you can ask Copilot questions by voice.",
        "NSSpeechRecognitionUsageDescription": "MMDI ONE uses speech recognition to turn your voice into text for Copilot."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F9"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "MMDI ONE uses your camera to photograph installation sites for your installation report.",
          "photosPermission": "MMDI ONE lets you attach photos from your library to your installation report.",
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MMDI ONE uses your microphone so you can ask Copilot questions by voice.",
          "speechRecognitionPermission": "MMDI ONE uses speech recognition to turn your voice into text for Copilot."
        }
      ],
      "./plugins/withForceMicPermissions.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6170d176-916e-4e52-b1e2-e4a1d64b218f"
      }
    }
  }
}
